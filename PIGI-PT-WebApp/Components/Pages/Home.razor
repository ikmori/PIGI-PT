@page "/"
@using PIGI_PT_WebApp.Models
@using PIGI_PT_WebApp.Services
@inject IDashboardService DashboardService
@inject ITicketService TicketService
@inject IAuthService AuthService

<PageTitle>Dashboard - PIGI-PT</PageTitle>

@if (currentUser == null || metrics == null)
{
    <div class="text-center mt-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
    </div>
}
else
{
    @switch (currentUser.Rol)
    {
        case Rol.SuperAdmin:
        case Rol.Admin:
            <AdminDashboard Metrics="metrics" HighPriorityTickets="HighPriorityTickets" />
            break;

        case Rol.Operador:
            <OperadorDashboard Metrics="metrics" HighPriorityTickets="HighPriorityTickets" UserName="@currentUser.Nombre" />
            break;

        case Rol.UsuarioGeneral:
            <UsuarioDashboard Metrics="metrics" HighPriorityTickets="HighPriorityTickets" UserName="@currentUser.Nombre" />
            break;
    }
}

@code {
    private Usuario? currentUser;
    private DashboardMetrics? metrics;
    private List<Ticket>? HighPriorityTickets;

    protected override async Task OnInitializedAsync()
    {
        currentUser = await AuthService.GetCurrentUserAsync();
        metrics = await DashboardService.GetMetricsAsync();
        HighPriorityTickets = await TicketService.GetHighPriorityTicketsAsync(3);
    }
}