@page "/login"
@layout PIGI_PT_WebApp.Components.Layout.AuthLayout

<PageTitle>Login - PIGI-PT</PageTitle>

<div class="glass-card p-5 text-center shadow-lg" style="border-radius: 1.5rem;">
    <div class="mb-4">
        <i class="bi bi-shield-check text-primary" style="font-size: 3rem; color: var(--color-secondary) !important;"></i>
        <h3 class="fw-bold mt-2 mb-1" style="color: var(--text-primary);">Bienvenido a PIGI-PT</h3>
        <p class="text-muted small">Plataforma Inteligente de Gestión de Incidentes</p>
    </div>

    <EditForm Model="this" class="text-start mt-4">
        <div class="form-floating mb-3">
            <input type="email" class="form-control" id="floatingInput" placeholder="name@example.com" value="admin@empresa.com">
            <label for="floatingInput" class="text-muted"><i class="bi bi-envelope me-2"></i>Correo electrónico</label>
        </div>
        <div class="form-floating mb-4">
            <input type="password" class="form-control" id="floatingPassword" placeholder="Password" value="password123">
            <label for="floatingPassword" class="text-muted"><i class="bi bi-lock me-2"></i>Contraseña</label>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" value="" id="rememberMe" checked>
                <label class="form-check-label text-muted small" for="rememberMe">
                    Recordarme
                </label>
            </div>
            <a href="#" class="small text-decoration-none" style="color: var(--color-secondary);">¿Olvidaste tu contraseña?</a>
        </div>

        <button class="btn btn-premium w-100 py-3 fs-5 mb-3 d-flex justify-content-center align-items-center gap-2" type="button" @onclick="NavigateToHome">
            Iniciar Sesión <i class="bi bi-arrow-right"></i>
        </button>
    </EditForm>
</div>

@code {
    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    private void NavigateToHome()
    {
        Navigation.NavigateTo("");
    }
}
