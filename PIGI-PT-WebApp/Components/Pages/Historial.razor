@page "/historial"
@using PIGI_PT_WebApp.Models
@using PIGI_PT_WebApp.Services
@inject ITicketService TicketService

<PageTitle>Historial de Tickets - PIGI-PT</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0 text-dark">Historial de Tickets</h2>
        <p class="text-muted mb-0">Gestión y seguimiento de todos los incidentes registrados.</p>
    </div>
</div>

<div class="glass-card overflow-hidden">
    <!-- Toolbar -->
    <div class="p-4 border-bottom d-flex justify-content-between align-items-center bg-light">
        <div class="position-relative" style="width: 300px;">
            <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
            <input type="text" class="form-control ps-5 bg-white border-0 shadow-sm" placeholder="Buscar ticket o descripción...">
        </div>
        <div class="d-flex gap-2">
            <select class="form-select border-0 shadow-sm text-muted" style="width: 150px;">
                <option>Cualquier Estado</option>
                <option>Nuevo</option>
                <option>En Progreso</option>
            </select>
            <button class="btn btn-outline-secondary bg-white border-0 shadow-sm">
                <i class="bi bi-funnel"></i> Filtrar
            </button>
        </div>
    </div>

    <!-- Table -->
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light text-muted small fw-semibold text-uppercase">
                <tr>
                    <th class="px-4 py-3 border-bottom-0">Código</th>
                    <th class="py-3 border-bottom-0">Incidente</th>
                    <th class="py-3 border-bottom-0">Estado</th>
                    <th class="py-3 border-bottom-0">Prioridad</th>
                    <th class="py-3 border-bottom-0">Asignado a</th>
                    <th class="py-3 border-bottom-0">Fecha</th>
                    <th class="px-4 py-3 border-bottom-0 text-end">Acción</th>
                </tr>
            </thead>
            <tbody>
                @if (Tickets == null)
                {
                    <tr>
                        <td colspan="7" class="text-center py-4">
                            <div class="spinner-border spinner-border-sm text-primary" role="status"></div> Cargando tickets...
                        </td>
                    </tr>
                }
                else if (!Tickets.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">
                            No hay tickets registrados en el sistema.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var ticket in Tickets)
                    {
                        <tr style="cursor: pointer;">
                            <td class="px-4 py-3 text-primary fw-medium">@ticket.Codigo</td>
                            <td class="py-3">
                                <div class="fw-semibold text-dark">@ticket.Titulo</div>
                                <div class="text-muted small text-truncate" style="max-width: 250px;">@ticket.Descripcion</div>
                            </td>
                            <td class="py-3">
                                <span class="badge badge-status @GetBadgeClass(ticket.Estado)">@ticket.Estado.ToString()</span>
                            </td>
                            <td class="py-3">
                                <span class="fw-medium @GetPriorityColor(ticket.Prioridad)">
                                    <i class="bi @GetPriorityIcon(ticket.Prioridad) me-1"></i> @ticket.Prioridad.ToString()
                                </span>
                            </td>
                            <td class="py-3 text-muted">
                                @if (!string.IsNullOrEmpty(ticket.AsignadoANombre))
                                {
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="avatar-sm bg-secondary text-white rounded-circle d-flex justify-content-center align-items-center" style="width:24px; height:24px; font-size: 0.7rem;">
                                            @ticket.AsignadoANombre.Substring(0,1)
                                        </div>
                                        @ticket.AsignadoANombre
                                    </div>
                                }
                                else
                                {
                                    <span>--</span>
                                }
                            </td>
                            <td class="py-3 text-muted small">@ticket.FechaCreacion.ToString("dd MMM yyyy, HH:mm")</td>
                            <td class="px-4 py-3 text-end">
                                <button class="btn btn-sm btn-light text-primary">Ver</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    
    <!-- Pagination -->
    <div class="p-3 border-top d-flex justify-content-between align-items-center bg-light">
        <span class="text-muted small">Mostrando registros activos</span>
        <nav>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item disabled"><a class="page-link border-0 shadow-sm text-muted" href="#">Anterior</a></li>
                <li class="page-item active"><a class="page-link border-0 shadow-sm bg-secondary text-white" href="#">1</a></li>
                <li class="page-item"><a class="page-link border-0 shadow-sm text-muted" href="#">Siguiente</a></li>
            </ul>
        </nav>
    </div>
</div>

@code {
    private List<Ticket>? Tickets;

    protected override async Task OnInitializedAsync()
    {
        Tickets = await TicketService.GetTicketsAsync();
    }

    private string GetBadgeClass(EstadoTicket estado)
    {
        return estado switch
        {
            EstadoTicket.Nuevo => "badge-nuevo",
            EstadoTicket.AnalizadoPorIA => "badge-analizado",
            EstadoTicket.EnProgreso => "badge-en-progreso",
            EstadoTicket.Resuelto => "badge-resuelto",
            EstadoTicket.Cerrado => "bg-secondary text-white",
            _ => "bg-secondary text-white"
        };
    }

    private string GetPriorityColor(NivelPrioridad prioridad)
    {
        return prioridad switch
        {
            NivelPrioridad.Baja => "text-success",
            NivelPrioridad.Media => "text-warning",
            NivelPrioridad.Alta => "text-danger",
            NivelPrioridad.Critica => "text-danger fw-bold",
            _ => "text-muted"
        };
    }

    private string GetPriorityIcon(NivelPrioridad prioridad)
    {
        return prioridad switch
        {
            NivelPrioridad.Baja => "bi-arrow-down-circle",
            NivelPrioridad.Media => "bi-dash-circle",
            NivelPrioridad.Alta => "bi-arrow-up-circle",
            NivelPrioridad.Critica => "bi-exclamation-octagon",
            _ => "bi-circle"
        };
    }
}
