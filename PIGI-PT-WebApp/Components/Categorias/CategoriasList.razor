@page "/categorias"
@using PIGI_PT_WebApp.Models
@using PIGI_PT_WebApp.Services
@inject IAuthService AuthService
@inject ICategoriaService CategoriaService
@inject ITicketService TicketService
@inject IUsuarioService UsuarioService
@using System.Linq

<PageTitle>Categorías - PIGI-PT</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0 text-dark">Gestión de Categorías</h2>
        <p class="text-muted mb-0">Define las áreas funcionales para clasificar tickets y asignar operadores.</p>
    </div>
    <button class="btn btn-premium d-flex align-items-center gap-2" @onclick="MostrarFormCreacion">
        <i class="bi bi-folder-plus"></i> Nueva Categoría
    </button>
</div>

@* ── Lista de Categorías ── *@
<div class="row g-4">
    @foreach (var cat in categorias)
    {
        <div class="col-md-6 col-lg-4">
            <div class="glass-card p-4 h-100 d-flex flex-column">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-2 rounded @GetCategoriaColorClass(cat)" style="width: 44px; height: 44px; display: flex; align-items: center; justify-content: center;">
                            <i class="bi @GetCategoriaIcon(cat) fs-5"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-0">@cat.Nombre</h6>
                            <small class="text-muted">@cat.TicketsCount tickets activos</small>
                        </div>
                    </div>
                    <span class="badge @(cat.IsActive ? "bg-success bg-opacity-10 text-success" : "bg-danger bg-opacity-10 text-danger")">
                        @(cat.IsActive ? "Activa" : "Inactiva")
                    </span>
                </div>
                <p class="text-muted small mb-3 flex-grow-1">@cat.Descripcion</p>
                <div class="d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-1">
                        <i class="bi bi-people text-primary"></i>
                        <small class="text-muted">@cat.OperadoresCount responsables</small>
                    </div>
                    <div class="d-flex gap-1">
                        <button class="btn btn-sm btn-outline-primary" title="Asignar Responsables" @onclick="() => AbrirModalAsignacion(cat)">
                            <i class="bi bi-pencil"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@* ── Modal de Creación ── *@
@if (mostrarFormCreacion)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header border-0">
                    <h5 class="modal-title fw-bold">Nueva Categoría</h5>
                    <button type="button" class="btn-close" @onclick="CerrarFormCreacion"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Nombre de la Categoría</label>
                        <input type="text" class="form-control" @bind="nuevoNombre" placeholder="Ej: Redes, Servidores, Software..." />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Descripción</label>
                        <textarea class="form-control" rows="3" @bind="nuevaDescripcion" placeholder="Describe el área de responsabilidad..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button class="btn btn-secondary" @onclick="CerrarFormCreacion">Cancelar</button>
                    <button class="btn btn-premium" @onclick="CrearCategoria">Crear Categoría</button>
                </div>
            </div>
        </div>
    </div>
}

@* ── Modal de Asignación ── *@
@if (categoriaEditando != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header border-0">
                    <h5 class="modal-title fw-bold">Asignar Responsables a @categoriaEditando.Nombre</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModalAsignacion"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small mb-3">Selecciona los usuarios que deben recibir los incidentes asignados a esta categoría.</p>
                    <div class="list-group">
                        @foreach (var user in usuariosParaAsignar)
                        {
                            <label class="list-group-item d-flex gap-2">
                                <input class="form-check-input flex-shrink-0" type="checkbox" @bind="user.IsAssigned" />
                                <span>
                                    @user.Nombre
                                    <small class="d-block text-muted">@user.Rol</small>
                                </span>
                            </label>
                        }
                        @if (usuariosParaAsignar.Count == 0)
                        {
                            <div class="text-center text-muted p-3">
                                No hay usuarios con rol de Responsable de Tecnología.
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer border-0">
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="text-danger small me-auto">
                            @errorMessage
                        </div>
                    }
                    <button class="btn btn-secondary" @onclick="CerrarModalAsignacion">Cancelar</button>
                    <button class="btn btn-premium" @onclick="GuardarAsignaciones">Guardar Asignaciones</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private Usuario? currentUser;
    private List<CategoriaListItem> categorias = new();
    private bool mostrarFormCreacion = false;
    private CategoriaListItem? categoriaEditando = null;
    private List<UserSelection> usuariosParaAsignar = new();
    private string errorMessage = "";

    private string nuevoNombre = "";
    private string nuevaDescripcion = "";

    protected override async Task OnInitializedAsync()
    {
        currentUser = await AuthService.GetCurrentUserAsync();
        await CargarCategoriasReal();
    }

    private async Task CargarCategoriasReal()
    {
        if (currentUser != null)
        {
            var list = await CategoriaService.GetCategoriasAsync(currentUser.InquilinoId);
            var tickets = await TicketService.GetTicketsAsync();
            var usuarios = await UsuarioService.GetUsuariosAsync(currentUser.InquilinoId);

            categorias = list.Select(c => new CategoriaListItem
            {
                Id = c.Id,
                Nombre = c.Nombre,
                Descripcion = c.Descripcion,
                TicketsCount = tickets.Count(t => t.CategoriaId == c.Id && t.Estado != EstadoTicket.Resuelto && t.Estado != EstadoTicket.Cerrado),
                OperadoresCount = usuarios.Count(u => u.Rol == Rol.DepartamentoTecnologia && u.DepartamentoId == c.Id),
                IsActive = true
            }).ToList();
        }
    }

    private void MostrarFormCreacion() => mostrarFormCreacion = true;
    private void CerrarFormCreacion() { mostrarFormCreacion = false; nuevoNombre = ""; nuevaDescripcion = ""; }

    private async Task CrearCategoria()
    {
        if (!string.IsNullOrWhiteSpace(nuevoNombre) && currentUser != null)
        {
            var nueva = new Categoria
            {
                Nombre = nuevoNombre,
                Descripcion = nuevaDescripcion,
                Id = currentUser.InquilinoId // Map InquilinoId temporarily in Id property
            };
            await CategoriaService.CreateCategoriaAsync(nueva);
            await CargarCategoriasReal();
            CerrarFormCreacion();
        }
    }

    private async Task AbrirModalAsignacion(CategoriaListItem cat)
    {
        errorMessage = "";
        categoriaEditando = cat;
        if (currentUser != null)
        {
            var usuarios = await UsuarioService.GetUsuariosAsync(currentUser.InquilinoId);
            usuariosParaAsignar = usuarios
                .Where(u => u.Rol == Rol.DepartamentoTecnologia || u.Rol == Rol.Admin)
                .Select(u => new UserSelection
                {
                    UsuarioId = u.Id,
                    Nombre = u.Nombre,
                    Rol = u.Rol.ToString(),
                    IsAssigned = u.DepartamentoId == cat.Id,
                    OriginalAssigned = u.DepartamentoId == cat.Id
                }).ToList();
        }
    }

    private void CerrarModalAsignacion()
    {
        categoriaEditando = null;
    }

    private async Task GuardarAsignaciones()
    {
        errorMessage = "";
        if (categoriaEditando != null && currentUser != null)
        {
            try
            {
                foreach (var user in usuariosParaAsignar)
                {
                    if (user.IsAssigned && !user.OriginalAssigned)
                    {
                        await UsuarioService.AsignarCategoriaAsync(user.UsuarioId, categoriaEditando.Id, currentUser.Id);
                    }
                    else if (!user.IsAssigned && user.OriginalAssigned)
                    {
                        await UsuarioService.DesasignarCategoriaAsync(user.UsuarioId, categoriaEditando.Id, currentUser.Id);
                    }
                }
                await CargarCategoriasReal();
                CerrarModalAsignacion();
            }
            catch (Exception ex)
            {
                errorMessage = "Ocurrió un error al guardar: " + ex.Message;
            }
        }
    }

    private string GetCategoriaColorClass(CategoriaListItem cat)
    {
        var hash = Math.Abs(cat.Nombre.GetHashCode()) % 5;
        return hash switch
        {
            0 => "bg-primary bg-opacity-10 text-primary",
            1 => "bg-success bg-opacity-10 text-success",
            2 => "bg-warning bg-opacity-10 text-warning",
            3 => "bg-info bg-opacity-10 text-info",
            4 => "bg-danger bg-opacity-10 text-danger",
            _ => "bg-secondary bg-opacity-10 text-secondary"
        };
    }

    private string GetCategoriaIcon(CategoriaListItem cat)
    {
        return cat.Nombre.ToLower() switch
        {
            "redes" => "bi-hdd-network",
            "servidores" => "bi-hdd-rack",
            "software" => "bi-code-square",
            "seguridad" => "bi-shield-lock",
            "base de datos" => "bi-database",
            "help desk" => "bi-headset",
            _ => "bi-folder2"
        };
    }

    private class CategoriaListItem
    {
        public Guid Id { get; set; } = Guid.NewGuid();
        public string Nombre { get; set; } = string.Empty;
        public string Descripcion { get; set; } = string.Empty;
        public int TicketsCount { get; set; }
        public int OperadoresCount { get; set; }
        public bool IsActive { get; set; } = true;
    }

    private class UserSelection
    {
        public Guid UsuarioId { get; set; }
        public string Nombre { get; set; } = string.Empty;
        public string Rol { get; set; } = string.Empty;
        public bool IsAssigned { get; set; }
        public bool OriginalAssigned { get; set; }
    }
}
