@page "/tickets"
@using PIGI_PT_WebApp.Models
@using PIGI_PT_WebApp.Services
@inject ITicketService TicketService
@inject IAuthService AuthService

<PageTitle>Tickets - PIGI-PT</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0 text-dark">@GetPageTitle()</h2>
        <p class="text-muted mb-0">@GetPageSubtitle()</p>
    </div>
    <a href="reporte/nuevo" class="btn btn-premium d-flex align-items-center gap-2">
        <i class="bi bi-plus-lg"></i> Nuevo Reporte
    </a>
</div>

@* ── Filtros ── *@
<div class="glass-card p-3 mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-3">
            <label class="form-label small fw-semibold text-muted">Estado</label>
            <select class="form-select" @bind="filtroEstado">
                <option value="">Todos</option>
                <option value="EnviadoAlArea">Enviado al Área</option>
                <option value="EnProgreso">En Progreso</option>
                <option value="Resuelto">Resuelto</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-semibold text-muted">Prioridad</label>
            <select class="form-select" @bind="filtroPrioridad">
                <option value="">Todas</option>
                <option value="Critica">Crítica</option>
                <option value="Alta">Alta</option>
                <option value="Media">Media</option>
                <option value="Baja">Baja</option>
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label small fw-semibold text-muted">Buscar</label>
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control" placeholder="Buscar por título..." @bind="filtroBusqueda" @bind:event="oninput" />
            </div>
        </div>
        <div class="col-md-2">
            <button class="btn btn-outline-secondary w-100" @onclick="LimpiarFiltros">
                <i class="bi bi-x-lg me-1"></i>Limpiar
            </button>
        </div>
    </div>
</div>

@* ── Tabla de Tickets ── *@
@if (tickets == null)
{
    <div class="text-center mt-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
    </div>
}
else if (!TicketsFiltrados.Any())
{
    <div class="glass-card p-5 text-center">
        <i class="bi bi-inbox fs-1 text-muted d-block mb-3"></i>
        <h5 class="text-muted">No se encontraron tickets</h5>
        <p class="text-muted small">Intenta ajustar los filtros o crea un nuevo reporte.</p>
    </div>
}
else
{
    <div class="glass-card p-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted small fw-semibold text-uppercase">
                    <tr>
                        <th class="px-4 py-3 border-bottom-0">Código</th>
                        <th class="py-3 border-bottom-0">Incidente</th>
                        <th class="py-3 border-bottom-0">Estado</th>
                        <th class="py-3 border-bottom-0">Prioridad</th>
                        <th class="py-3 border-bottom-0">Área asignada</th>
                        <th class="py-3 border-bottom-0">Fecha</th>
                        <th class="px-4 py-3 border-bottom-0 text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ticket in TicketsFiltrados)
                    {
                        <tr>
                            <td class="px-4 py-3 text-primary fw-medium">@ticket.Codigo</td>
                            <td class="py-3">
                                <div class="fw-semibold text-dark">
                                    @ticket.Titulo
                                    @if (ticket.Sanitizado)
                                    {
                                        <i class="bi bi-robot text-info ms-1" title="Analizado por IA"></i>
                                    }
                                </div>
                                <div class="text-muted small text-truncate" style="max-width: 260px;">@ticket.Descripcion</div>
                            </td>
                            <td class="py-3">
                                <span class="badge badge-status @GetBadgeClass(ticket.Estado)">@GetEstadoNombre(ticket.Estado)</span>
                            </td>
                            <td class="py-3">
                                <span class="fw-medium @GetPriorityColor(ticket.Prioridad)">
                                    <i class="bi @GetPriorityIcon(ticket.Prioridad) me-1"></i> @ticket.Prioridad.ToString()
                                </span>
                            </td>
                            <td class="py-3 text-muted">
                                @if (ticket.Categoria != null && !string.IsNullOrEmpty(ticket.Categoria.Nombre))
                                {
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="bg-primary text-white rounded-circle d-flex justify-content-center align-items-center fw-bold" style="width:26px; height:26px; font-size: 0.7rem;">
                                            @ticket.Categoria.Nombre[0]
                                        </div>
                                        @ticket.Categoria.Nombre
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted fst-italic small">Clasificando...</span>
                                }
                            </td>
                            <td class="py-3 text-muted small">@ticket.FechaCreacion.ToString("dd MMM yyyy, HH:mm")</td>
                            <td class="px-4 py-3 text-end" @onclick:stopPropagation="true">
                                <div class="d-flex gap-2 justify-content-end">
                                    <button class="btn btn-sm btn-outline-primary" title="Ver detalle" @onclick="() => VerDetalle(ticket)">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                    @if ((EsAdmin() || EsOperador()) && ticket.Estado == EstadoTicket.EnviadoAlArea)
                                    {
                                        <button class="btn btn-sm btn-outline-success" title="Tomar ticket" @onclick="() => AsignarTicket(ticket)">
                                            <i class="bi bi-person-check-fill"></i>
                                        </button>
                                    }
                                    @if ((EsAdmin() || EsOperador()) && ticket.Estado == EstadoTicket.EnProgreso)
                                    {
                                        <button class="btn btn-sm btn-outline-info" title="Resolver" @onclick="() => ConfirmarResolucion(ticket)">
                                            <i class="bi bi-check-lg"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="p-3 border-top bg-light d-flex justify-content-between align-items-center">
            <small class="text-muted">Mostrando @TicketsFiltrados.Count() de @tickets.Count tickets</small>
        </div>
    </div>
}

@* ── Modal de Detalle ── *@
@if (ticketSeleccionado != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">@ticketSeleccionado.Codigo — @ticketSeleccionado.Titulo</h5>
                    <button type="button" class="btn-close" @onclick="CerrarDetalle"></button>
                </div>
                <div class="modal-body pt-2">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="small fw-semibold text-muted d-block">Estado</label>
                            <span class="badge badge-status @GetBadgeClass(ticketSeleccionado.Estado) fs-6">@GetEstadoNombre(ticketSeleccionado.Estado)</span>
                        </div>
                        <div class="col-md-6">
                            <label class="small fw-semibold text-muted d-block">Prioridad</label>
                            <span class="fw-semibold @GetPriorityColor(ticketSeleccionado.Prioridad) fs-6">
                                <i class="bi @GetPriorityIcon(ticketSeleccionado.Prioridad) me-1"></i>@ticketSeleccionado.Prioridad.ToString()
                            </span>
                        </div>
                        <div class="col-12">
                            <label class="small fw-semibold text-muted d-block">Descripción</label>
                            <p class="mb-0">@ticketSeleccionado.Descripcion</p>
                        </div>
                        <div class="col-md-6">
                            <label class="small fw-semibold text-muted d-block">Creado por</label>
                            <span><i class="bi bi-person me-1"></i>@ticketSeleccionado.CreadorNombre</span>
                        </div>
                        <div class="col-md-6">
                            <label class="small fw-semibold text-muted d-block">Área asignada</label>
                            @if (ticketSeleccionado.Categoria != null && !string.IsNullOrEmpty(ticketSeleccionado.Categoria.Nombre))
                            {
                                <span><i class="bi bi-diagram-3 me-1"></i>@ticketSeleccionado.Categoria.Nombre</span>
                            }
                            else
                            {
                                <span class="text-muted fst-italic small">Clasificando...</span>
                            }
                        </div>
                        <div class="col-md-6">
                            <label class="small fw-semibold text-muted d-block">Fecha creación</label>
                            <span>@ticketSeleccionado.FechaCreacion.ToString("dd/MM/yyyy HH:mm:ss")</span>
                        </div>
                        @if (ticketSeleccionado.FechaResolucion.HasValue)
                        {
                            <div class="col-md-6">
                                <label class="small fw-semibold text-muted d-block">Fecha resolución</label>
                                <span>@ticketSeleccionado.FechaResolucion.Value.ToString("dd/MM/yyyy HH:mm:ss")</span>
                            </div>
                        }
                        @if (ticketSeleccionado.Sanitizado && !string.IsNullOrEmpty(ticketSeleccionado.SugerenciaIA))
                        {
                            <div class="col-12">
                                <div class="p-3 rounded bg-info bg-opacity-10 border border-info border-opacity-25">
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <i class="bi bi-robot text-info"></i>
                                        <span class="fw-semibold text-info">Sugerencia de IA</span>
                                    </div>
                                    <p class="mb-0 small">@ticketSeleccionado.SugerenciaIA</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button class="btn btn-secondary" @onclick="CerrarDetalle">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

@* ── Modal de Confirmación Resolución ── *@
@if (ticketAResolver != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-sm modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-body text-center pt-4 pb-4">
                    <i class="bi bi-check-circle text-success fs-1 mb-3 d-block"></i>
                    <h5 class="fw-bold mb-3">¿Resolver Ticket?</h5>
                    <p class="text-muted small mb-4">Estás a punto de marcar el ticket <strong>@ticketAResolver.Codigo</strong> como resuelto.</p>
                    @if (!string.IsNullOrEmpty(errorResolucion))
                    {
                        <div class="alert alert-danger small py-2 mb-3">@errorResolucion</div>
                    }
                    <div class="d-flex gap-2 justify-content-center">
                        <button class="btn btn-light" @onclick="CerrarConfirmacionResolucion" disabled="@resolviendo">Cancelar</button>
                        <button class="btn btn-success" @onclick="EjecutarResolucion" disabled="@resolviendo">
                            @if (resolviendo)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            }
                            Confirmar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}



@code {
    private Usuario? currentUser;
    private List<Ticket>? tickets;
    private Ticket? ticketSeleccionado;

    private Ticket? ticketAResolver;
    private bool resolviendo = false;
    private string errorResolucion = string.Empty;



    private string filtroEstado = "";
    private string filtroPrioridad = "";
    private string filtroBusqueda = "";

    protected override async Task OnInitializedAsync()
    {
        currentUser = await AuthService.GetCurrentUserAsync();
        tickets = await TicketService.GetTicketsAsync();
    }

    private IEnumerable<Ticket> TicketsFiltrados
    {
        get
        {
            if (tickets == null) return Enumerable.Empty<Ticket>();

            var filtrados = tickets.AsEnumerable();

            if (!string.IsNullOrEmpty(filtroEstado))
            {
                if (Enum.TryParse<EstadoTicket>(filtroEstado, out var estado))
                    filtrados = filtrados.Where(t => t.Estado == estado);
            }

            if (!string.IsNullOrEmpty(filtroPrioridad))
            {
                if (Enum.TryParse<NivelPrioridad>(filtroPrioridad, out var prioridad))
                    filtrados = filtrados.Where(t => t.Prioridad == prioridad);
            }

            if (!string.IsNullOrEmpty(filtroBusqueda))
            {
                filtrados = filtrados.Where(t =>
                    t.Titulo.Contains(filtroBusqueda, StringComparison.OrdinalIgnoreCase) ||
                    t.Descripcion.Contains(filtroBusqueda, StringComparison.OrdinalIgnoreCase));
            }

            return filtrados;
        }
    }

    private void LimpiarFiltros()
    {
        filtroEstado = "";
        filtroPrioridad = "";
        filtroBusqueda = "";
    }

    private void VerDetalle(Ticket ticket) => ticketSeleccionado = ticket;
    private void CerrarDetalle() => ticketSeleccionado = null;

    private void ConfirmarResolucion(Ticket ticket)
    {
        ticketAResolver = ticket;
        errorResolucion = string.Empty;
    }
    
    private void CerrarConfirmacionResolucion()
    {
        ticketAResolver = null;
        errorResolucion = string.Empty;
        resolviendo = false;
    }

    private async Task EjecutarResolucion()
    {
        if (ticketAResolver == null) return;
        resolviendo = true;
        errorResolucion = string.Empty;

        var ok = await TicketService.ResolveTicketAsync(ticketAResolver.Id);
        if (ok)
        {
            ticketAResolver.Estado = EstadoTicket.Resuelto;
            ticketAResolver.FechaResolucion = DateTime.UtcNow;
            CerrarConfirmacionResolucion();
        }
        else
        {
            errorResolucion = "No se pudo resolver el ticket.";
            resolviendo = false;
        }
    }



    private async Task AsignarTicket(Ticket ticket)
    {
        if (currentUser == null) return;
        var ok = await TicketService.AssignResponsableAsync(ticket.Id, currentUser.Id);
        if (ok)
        {
            ticket.Estado = EstadoTicket.EnProgreso;
            ticket.AsignadoAId = currentUser.Id;
            ticket.AsignadoANombre = currentUser.Nombre;
        }
    }

    private bool EsAdmin() => currentUser != null && currentUser.Rol == Rol.Admin;

    private bool EsOperador() => currentUser != null && currentUser.Rol == Rol.DepartamentoTecnologia;

    private string GetPageTitle()
    {
        if (currentUser == null) return "Tickets";
        return currentUser.Rol switch
        {
            Rol.Usuario => "Mis Reportes",
            _ => "Gestión de Tickets"
        };
    }

    private string GetPageSubtitle()
    {
        if (currentUser == null) return "";
        return currentUser.Rol switch
        {
            Rol.Usuario => "Historial de incidentes que has reportado.",
            _ => "Todos los tickets del inquilino con filtros avanzados."
        };
    }

    private string GetBadgeClass(EstadoTicket estado)
    {
        return estado switch
        {
            EstadoTicket.Nuevo => "badge-nuevo",
            EstadoTicket.EnviadoAlArea => "badge-analizado",
            EstadoTicket.EnProgreso => "badge-en-progreso",
            EstadoTicket.Resuelto => "badge-resuelto",
            _ => "bg-secondary"
        };
    }

    private string GetEstadoNombre(EstadoTicket estado)
    {
        return estado switch
        {
            EstadoTicket.Nuevo => "Nuevo",
            EstadoTicket.EnviadoAlArea => "Enviado al Área",
            EstadoTicket.EnProgreso => "En Progreso",
            EstadoTicket.Resuelto => "Resuelto",
            EstadoTicket.Cerrado => "Cerrado",
            EstadoTicket.Rechazado => "Rechazado",
            _ => estado.ToString()
        };
    }

    private string GetPriorityColor(NivelPrioridad p) => p switch
    {
        NivelPrioridad.Baja    => "text-success",
        NivelPrioridad.Media   => "text-warning",
        NivelPrioridad.Alta    => "text-danger",
        NivelPrioridad.Critica => "text-danger fw-bold",
        _                      => "text-muted"
    };

    private string GetPriorityIcon(NivelPrioridad p) => p switch
    {
        NivelPrioridad.Baja    => "bi-arrow-down-circle",
        NivelPrioridad.Media   => "bi-dash-circle",
        NivelPrioridad.Alta    => "bi-arrow-up-circle",
        NivelPrioridad.Critica => "bi-exclamation-octagon",
        _                      => "bi-circle"
    };
}
