@inherits LayoutComponentBase
@inject PIGI_PT_WebApp.Services.IAuthService AuthService
@inject NavigationManager Navigation
@using PIGI_PT_WebApp.Models

<div class="page d-flex vh-100 bg-light">
    <!-- Sidebar / NavMenu -->
    <div class="sidebar d-flex flex-column text-white" style="width: 260px; background-color: var(--bg-sidebar);">
        <div class="logo-area p-4 d-flex align-items-center gap-2 border-bottom border-secondary border-opacity-25">
            <i class="bi bi-shield-check fs-4 text-primary" style="color: var(--color-secondary) !important;"></i>
            <h5 class="m-0 fw-bold">PIGI-PT</h5>
        </div>
        
        <div class="flex-grow-1 overflow-auto">
            <NavMenu />
        </div>

        <div class="user-area p-3 border-top border-secondary border-opacity-25 d-flex align-items-center gap-3">
            @if (currentUser != null)
            {
                <div class="avatar bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; font-weight: 600;">
                    @(currentUser.Nombre.Substring(0, 2).ToUpper())
                </div>
                <div class="d-flex flex-column">
                    <span class="fs-6 fw-semibold">@currentUser.Nombre</span>
                    <span class="text-muted" style="font-size: 0.8rem;">@currentUser.Rol.ToString()</span>
                </div>
            }
            else
            {
                <div class="spinner-border spinner-border-sm text-light" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            }
        </div>
    </div>

    <!-- Main Content Area -->
    <main class="flex-grow-1 d-flex flex-column overflow-hidden">
        <!-- Topbar -->
        <header class="topbar px-4 py-3 bg-white border-bottom d-flex justify-content-between align-items-center shadow-sm" style="z-index: 10;">
            <div>
                <h4 class="m-0 fw-semibold text-dark">Panel de Control</h4>
            </div>
            <div class="d-flex align-items-center gap-4">

                <a href="/login" class="text-secondary" title="Cerrar sesión">
                    <i class="bi bi-box-arrow-right fs-5"></i>
                </a>
            </div>
        </header>

        <!-- Body -->
        <div class="main-content flex-grow-1 bg-main overflow-auto p-4">
            @Body
        </div>
    </main>
</div>

<div id="blazor-error-ui">
    Se produjo un error no controlado.
    <a href="" class="reload">Recargar</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private Usuario? currentUser;

    protected override async Task OnInitializedAsync()
    {
        currentUser = await AuthService.GetCurrentUserAsync();
        if (currentUser == null || string.IsNullOrEmpty(currentUser.Email))
        {
            Navigation.NavigateTo("login");
            return;
        }
    }
}