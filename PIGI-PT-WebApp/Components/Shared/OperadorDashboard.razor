@using PIGI_PT_WebApp.Models
@using PIGI_PT_WebApp.Services

<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0 text-dark">Mi Panel de Operador</h2>
        <p class="text-muted mb-0">Hola @UserName, aquí están los tickets de tu área.</p>
    </div>
    <a href="reporte/nuevo" class="btn btn-premium d-flex align-items-center gap-2">
        <i class="bi bi-plus-lg"></i> Nuevo Incidente
    </a>
</div>

<!-- KPI Cards (contextualizadas al operador) -->
<div class="row g-4 mb-5">
    <div class="col-md-4">
        <div class="glass-card p-4">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <p class="text-muted mb-1 fw-medium">Asignados a Mí</p>
                    <h3 class="fw-bold mb-0">@Metrics.ActiveTickets</h3>
                </div>
                <div class="p-2 rounded bg-primary bg-opacity-10 text-primary">
                    <i class="bi bi-person-badge fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="glass-card p-4">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <p class="text-muted mb-1 fw-medium">Urgentes</p>
                    <h3 class="fw-bold mb-0 text-warning">@Metrics.CriticalRisks</h3>
                </div>
                <div class="p-2 rounded bg-warning bg-opacity-10 text-warning">
                    <i class="bi bi-lightning-charge-fill fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="glass-card p-4">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <p class="text-muted mb-1 fw-medium">Tiempo Prom. Resolución</p>
                    <h3 class="fw-bold mb-0">@Metrics.ResolutionTimeHours h</h3>
                </div>
                <div class="p-2 rounded bg-success bg-opacity-10 text-success">
                    <i class="bi bi-stopwatch fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Tickets recientes de mi área -->
<div class="row g-4">
    <div class="col-12">
        <div class="glass-card p-0 overflow-hidden">
            <div class="p-4 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">Tickets Pendientes en Mi Área</h5>
                <a href="tickets" class="btn btn-sm btn-outline-primary">Ver Todos</a>
            </div>
            <div class="list-group list-group-flush">
                @if (HighPriorityTickets != null && HighPriorityTickets.Any())
                {
                    @foreach (var ticket in HighPriorityTickets)
                    {
                        <div class="list-group-item p-4 border-top" style="transition: background-color 0.2s;">
                            <div class="d-flex justify-content-between align-items-start mb-1">
                                <div>
                                    <h6 class="mb-0 fw-semibold">@ticket.Titulo</h6>
                                    <small class="text-muted">Reportado por: @ticket.CreadorNombre</small>
                                </div>
                                <div class="d-flex gap-2 align-items-center">
                                    <span class="badge @GetPrioridadBadgeClass(ticket.Prioridad)">@ticket.Prioridad.ToString()</span>
                                    <span class="badge badge-status @GetBadgeClass(ticket.Estado)">@ticket.Estado.ToString()</span>
                                </div>
                            </div>
                            <p class="text-muted small mb-2 text-truncate" style="max-width: 600px;">@ticket.Descripcion</p>
                            @if (ticket.Sanitizado)
                            {
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-info bg-opacity-10 text-info"><i class="bi bi-robot me-1"></i>IA: @ticket.SugerenciaIA</span>
                                </div>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="p-4 text-center text-muted">
                        <i class="bi bi-check-circle fs-3 d-block mb-2"></i>
                        ¡No hay tickets pendientes en tu área! 🎉
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public DashboardMetrics Metrics { get; set; } = new();
    [Parameter] public List<Ticket>? HighPriorityTickets { get; set; }
    [Parameter] public string UserName { get; set; } = string.Empty;

    private string GetBadgeClass(EstadoTicket estado)
    {
        return estado switch
        {
            EstadoTicket.Nuevo => "badge-nuevo",
            EstadoTicket.AnalizadoPorIA => "badge-analizado",
            EstadoTicket.EnProgreso => "badge-en-progreso",
            EstadoTicket.Resuelto => "badge-resuelto",
            _ => "bg-secondary"
        };
    }

    private string GetPrioridadBadgeClass(NivelPrioridad prioridad)
    {
        return prioridad switch
        {
            NivelPrioridad.Critica => "bg-danger",
            NivelPrioridad.Alta => "bg-warning text-dark",
            NivelPrioridad.Media => "bg-info",
            NivelPrioridad.Baja => "bg-secondary",
            _ => "bg-secondary"
        };
    }
}
