@using PIGI_PT_WebApp.Models
@using PIGI_PT_WebApp.Services

<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0 text-dark">Mi Resumen</h2>
        <p class="text-muted mb-0">Hola @UserName, aquí está el estado de tus reportes.</p>
    </div>
    <a href="reporte/nuevo" class="btn btn-premium d-flex align-items-center gap-2">
        <i class="bi bi-plus-lg"></i> Nuevo Reporte
    </a>
</div>

<!-- KPI Cards (simplificadas para el usuario general) -->
<div class="row g-4 mb-5">
    <div class="col-md-4">
        <div class="glass-card p-4">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <p class="text-muted mb-1 fw-medium">Mis Reportes Activos</p>
                    <h3 class="fw-bold mb-0">@Metrics.ActiveTickets</h3>
                </div>
                <div class="p-2 rounded bg-primary bg-opacity-10 text-primary">
                    <i class="bi bi-file-earmark-text fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="glass-card p-4">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <p class="text-muted mb-1 fw-medium">Resueltos</p>
                    <h3 class="fw-bold mb-0 text-success">0</h3>
                </div>
                <div class="p-2 rounded bg-success bg-opacity-10 text-success">
                    <i class="bi bi-check-circle fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="glass-card p-4">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <p class="text-muted mb-1 fw-medium">Tiempo Estimado</p>
                    <h3 class="fw-bold mb-0">@Metrics.ResolutionTimeHours h</h3>
                </div>
                <div class="p-2 rounded bg-info bg-opacity-10 text-info">
                    <i class="bi bi-hourglass-split fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Mis últimos reportes -->
<div class="row g-4">
    <div class="col-12">
        <div class="glass-card p-0 overflow-hidden">
            <div class="p-4 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">Mis Últimos Reportes</h5>
                <a href="historial" class="btn btn-sm btn-outline-primary">Ver Historial</a>
            </div>
            <div class="list-group list-group-flush">
                @if (HighPriorityTickets != null && HighPriorityTickets.Any())
                {
                    @foreach (var ticket in HighPriorityTickets)
                    {
                        <div class="list-group-item p-4 border-top" style="transition: background-color 0.2s;">
                            <div class="d-flex justify-content-between align-items-start mb-1">
                                <h6 class="mb-0 fw-semibold">@ticket.Titulo</h6>
                                <span class="badge badge-status @GetBadgeClass(ticket.Estado)">@ticket.Estado.ToString()</span>
                            </div>
                            <p class="text-muted small mb-2">@ticket.Descripcion</p>
                            <div class="d-flex align-items-center justify-content-between small">
                                <span class="text-muted"><i class="bi bi-calendar3 me-1"></i>@ticket.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</span>
                                @if (!string.IsNullOrEmpty(ticket.AsignadoANombre))
                                {
                                    <span class="text-primary"><i class="bi bi-person me-1"></i>Asignado a: @ticket.AsignadoANombre</span>
                                }
                                else
                                {
                                    <span class="text-muted"><i class="bi bi-hourglass me-1"></i>Pendiente de asignación</span>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="p-4 text-center text-muted">
                        <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                        No has creado reportes aún. ¡Crea uno para empezar!
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Tip informativo -->
<div class="row mt-4">
    <div class="col-12">
        <div class="glass-card p-4 bg-primary bg-opacity-10 border-0">
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-lightbulb text-primary fs-3"></i>
                <div>
                    <h6 class="fw-bold mb-1 text-primary">¿Necesitas ayuda?</h6>
                    <p class="mb-0 small text-muted">Crea un nuevo reporte describiendo tu incidente y nuestro sistema de IA lo clasificará automáticamente para asignarlo al operador más adecuado.</p>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public DashboardMetrics Metrics { get; set; } = new();
    [Parameter] public List<Ticket>? HighPriorityTickets { get; set; }
    [Parameter] public string UserName { get; set; } = string.Empty;

    private string GetBadgeClass(EstadoTicket estado)
    {
        return estado switch
        {
            EstadoTicket.Nuevo => "badge-nuevo",
            EstadoTicket.AnalizadoPorIA => "badge-analizado",
            EstadoTicket.EnProgreso => "badge-en-progreso",
            EstadoTicket.Resuelto => "badge-resuelto",
            _ => "bg-secondary"
        };
    }
}
